{
  "name": "beauty-spa-backend",
  "version": "1.0.0",
  "description": "美容預約系統後端 API",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc",
    "prestart": "node dist/scripts/migrate.js",
    "start": "node dist/app.js",
    "db:init": "ts-node src/scripts/migrate.ts",
    "set-role": "ts-node src/scripts/setRole.ts",
    "migrate": "ts-node src/scripts/migrate.ts",
    "demo:past": "ts-node src/scripts/demoPastAppointments.ts",
    "reset-password": "ts-node src/scripts/resetPassword.ts",
    "db:copy": "ts-node src/scripts/copyDb.ts",
    "test": "vitest run",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.5",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.19.0",
    "nodemailer": "^10.0.16",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
