# 伺服器設定
PORT=3001
FRONTEND_URL=

# 資料庫設定
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=beauty_booking

# JWT 設定
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/oauth/google/callback

# LINE OAuth
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CALLBACK_URL=http://localhost:3001/api/oauth/line/callback

# 前台網址（CORS 允許的來源）
ALLOWED_ORIGIN=https://spa-reservation-nu.vercel.app

# 寄信（三選一，依序：Brevo → SMTP → 都沒設就寫進 logs/dev-mail.log）
# Render 免費方案封鎖 SMTP 連接埠，線上請用 Brevo
BREVO_API_KEY=
MAIL_FROM=美容預約系統 <your-verified-email@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# 後台登入頁顯示「一鍵登入展示帳號」（給面試官／訪客用）
ADMIN_DEMO_LOGIN=true
